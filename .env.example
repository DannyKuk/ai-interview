OPENROUTER_API_KEY=sk-or-v1-xxx

# Optional: these are the defaults from backend/src/backend/config.py
OPENROUTER_API_BASE=https://openrouter.ai/api/v1
DEFAULT_MODEL=openai/gpt-5-mini
ALLOWED_MODELS=["openai/gpt-5-mini","openai/gpt-5-nano"]
LLM_TIMEOUT_MS=30000
FEEDBACK_TIMEOUT_MS=60000
MODELS_TIMEOUT_MS=5000
GUARD_MODEL=typesafe/jev-1.13
GUARD_THRESHOLD=0.5
GUARD_TIMEOUT_MS=5000
GUARD_RETRIES=1
END_THRESHOLD=0.7
OFF_TOPIC_THRESHOLD=0.7
NOT_ANSWERED_THRESHOLD=0.3
FOLLOW_UP_THRESHOLD=0.5
WRONG_CLAIM_THRESHOLD=0.8
CONTRADICTION_THRESHOLD=0.5
UNVERIFIED_THRESHOLD=0.45
DOCUMENT_MIN_MATCH=0.5
CHAT_RATE_LIMIT=20/minute
CV_RATE_LIMIT=5/minute
STT_RATE_LIMIT=120/minute
TTS_RATE_LIMIT=60/minute
SESSION_COST_CAP_USD=0.10
# baked into the backend's Docker image (offline): another model only works outside Docker
STT_MODEL=nemo-parakeet-tdt-0.6b-v2
STT_THREADS=4
TTS_MODEL=google/gemini-3.8-flash-lite-tts
TTS_TIMEOUT_MS=15000
TTS_USD_PER_AUDIO_SECOND=0.00015
CORS_ORIGINS=["http://localhost:3000"]
# Signs the interview plan (min. 32 chars). Unset = random per start, so a restart
# (or uvicorn --reload) invalidates open interviews. Make one with:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
# PLAN_SIGNING_KEY=

# Frontend: backend URL for the browser, inlined at build time (Docker build arg).
# Next.js does not read this root file; locally lib/api.ts falls back to http://localhost:8000.
NEXT_PUBLIC_API_URL=http://localhost:8000
# HeadTTS (local voice service) for the browser. lib/headtts.ts falls back to :8882
NEXT_PUBLIC_HEADTTS_URL=http://localhost:8882
