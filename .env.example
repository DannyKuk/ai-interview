OPENROUTER_API_KEY=sk-or-v1-xxx

# Optional: these are the defaults from backend/src/backend/config.py
OPENROUTER_API_BASE=https://openrouter.ai/api/v1
DEFAULT_MODEL=openai/gpt-5-mini
ALLOWED_MODELS=["openai/gpt-5-mini","openai/gpt-5-nano"]
LLM_TIMEOUT_MS=30000
MODELS_TIMEOUT_MS=5000
GUARD_MODEL=typesafe/jev-1.13
GUARD_THRESHOLD=0.5
GUARD_TIMEOUT_MS=5000
END_THRESHOLD=0.7
OFF_TOPIC_THRESHOLD=0.7
NOT_ANSWERED_THRESHOLD=0.3
CHAT_RATE_LIMIT=20/minute
SESSION_COST_CAP_USD=0.10
CORS_ORIGINS=["http://localhost:3000"]

# Frontend: backend URL for the browser, inlined at build time (Docker build arg).
# Next.js does not read this root file; locally lib/api.ts falls back to http://localhost:8000.
NEXT_PUBLIC_API_URL=http://localhost:8000
